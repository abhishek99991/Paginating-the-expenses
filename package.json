{
  "name": "expense-pagination",
  "version": "1.0.0",
  "description": "Expense report app with React pagination and an Express/Sequelize backend example",
  "scripts": {
    "install:all": "npm install && npm install --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server.js",
    "client": "npm run dev --prefix client"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}